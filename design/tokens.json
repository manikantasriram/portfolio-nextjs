{
  "$description": "Design tokens for manikantasriram.vercel.app, in the W3C Design Tokens format. app/globals.css is the source of truth; `npm run tokens:check` fails if the colours here drift from it.",
  "color": {
    "light": {
      "bg": { "$type": "color", "$value": "#ffffff", "$description": "Page background" },
      "surface": { "$type": "color", "$value": "#f7f7f8", "$description": "Cards, code card, chips" },
      "line": { "$type": "color", "$value": "#e4e4e7", "$description": "Borders and hairline rules" },
      "ink": { "$type": "color", "$value": "#09090b", "$description": "Headings and body text (19.9:1)" },
      "mute": { "$type": "color", "$value": "#52525b", "$description": "Secondary text, captions (7.7:1)" },
      "c": { "$type": "color", "$value": "#63636d", "$description": "Comments, hashes, labels (5.9:1)" },
      "acc": { "$type": "color", "$value": "#2563eb", "$description": "Accent, links, focus ring (5.2:1)" },
      "br": { "$type": "color", "$value": "#7c3aed", "$description": "Freelance branch label (5.7:1)" },
      "ok": { "$type": "color", "$value": "#15803d", "$description": "Live status (5.0:1)" },
      "warn": { "$type": "color", "$value": "#b45309", "$description": "In-progress status (5.0:1)" },
      "k": { "$type": "color", "$value": "#be123c", "$description": "Code keywords" },
      "s": { "$type": "color", "$value": "#15803d", "$description": "Code strings" },
      "p": { "$type": "color", "$value": "#1d4ed8", "$description": "Code properties, JSON keys (6.7:1)" },
      "n": { "$type": "color", "$value": "#a16207", "$description": "Code numbers (4.9:1)" },
      "o1": { "$type": "color", "$value": "#fcfcfd", "$description": "Skill logo highlight" },
      "o2": { "$type": "color", "$value": "#e7e7ea", "$description": "Skill logo shade" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#000000", "$description": "Page background" },
      "surface": { "$type": "color", "$value": "#0c0c0e", "$description": "Cards, code card, chips" },
      "line": { "$type": "color", "$value": "#27272a", "$description": "Borders and hairline rules" },
      "ink": { "$type": "color", "$value": "#fafafa", "$description": "Headings and body text (20.1:1)" },
      "mute": { "$type": "color", "$value": "#a1a1aa", "$description": "Secondary text, captions (8.2:1)" },
      "c": { "$type": "color", "$value": "#8a8a93", "$description": "Comments, hashes, labels (6.1:1)" },
      "acc": { "$type": "color", "$value": "#60a5fa", "$description": "Accent, links, focus ring (8.3:1)" },
      "br": { "$type": "color", "$value": "#a78bfa", "$description": "Freelance branch label (7.7:1)" },
      "ok": { "$type": "color", "$value": "#4ade80", "$description": "Live status (12.1:1)" },
      "warn": { "$type": "color", "$value": "#fb923c", "$description": "In-progress status (9.3:1)" },
      "k": { "$type": "color", "$value": "#fb7185", "$description": "Code keywords" },
      "s": { "$type": "color", "$value": "#4ade80", "$description": "Code strings" },
      "p": { "$type": "color", "$value": "#7dd3fc", "$description": "Code properties, JSON keys (12.6:1)" },
      "n": { "$type": "color", "$value": "#fbbf24", "$description": "Code numbers (12.6:1)" },
      "o1": { "$type": "color", "$value": "#2a2a30", "$description": "Skill logo highlight" },
      "o2": { "$type": "color", "$value": "#0a0a0c", "$description": "Skill logo shade" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Space Grotesk", "DM Sans", "system-ui", "sans-serif"], "$description": "Weights 500 and 700" },
    "body": { "$type": "fontFamily", "$value": ["DM Sans", "system-ui", "sans-serif"], "$description": "Weights 400, 500 and 700" },
    "mono": { "$type": "fontFamily", "$value": ["DM Mono", "ui-monospace", "monospace"], "$description": "Weights 400 and 500" }
  },
  "fontSize": {
    "xs": { "$type": "dimension", "$value": "13px" },
    "sm": { "$type": "dimension", "$value": "15px" },
    "md": { "$type": "dimension", "$value": "17px", "$description": "16px under 720px wide" },
    "d1": { "$type": "dimension", "$value": "clamp(3.25rem, 17vw, 8rem)", "$description": "The name" },
    "d2": { "$type": "dimension", "$value": "clamp(2rem, 4.2vw + 0.8rem, 3.5rem)", "$description": "Section titles" },
    "d3": { "$type": "dimension", "$value": "clamp(1.6rem, 2.4vw + 0.8rem, 2.6rem)", "$description": "Project titles" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "tag": { "$type": "dimension", "$value": "6px" }
  },
  "layout": {
    "gutter": { "$type": "dimension", "$value": "220px", "$description": "Left column shared by Skills and Education" },
    "statusBar": { "$type": "dimension", "$value": "28px" },
    "minTarget": { "$type": "dimension", "$value": "24px", "$description": "40px on touch screens" }
  },
  "motion": {
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] }
  }
}
